<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2x2 home widget: header, the paired frame's product render, then the
  glasses and case readouts (dot-matrix number, ten-dot gauge, label).

  Every piece of text is an ImageView. Launchers inflate RemoteViews in a
  restricted context, where TextView ignores android:fontFamily font
  resources, so Doto and Geist Mono would silently fall back to the system
  font. FaceclawHomeWidget draws the text in Faceclaw's process as white
  masks instead, and the launcher tints them from values / values-night, so
  the tile still follows the system theme without a repaint.

  The root takes @android:id/background so Android 12+ launchers can animate
  from the tile into the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:importantForAccessibility="no"
            android:tint="@color/widget_dim" />

        <!-- Connected: a dot. Otherwise the time last seen, or "Pair". -->
        <ImageView
            android:id="@+id/widget_conn"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_gravity="end|center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_conn_dot"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:importantForAccessibility="no"
            android:tint="@color/widget_dim"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_art_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_art_glow"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_glasses_art"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_glasses_g2" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <!-- Number plus "%" or the charging bolt; tinted per state (white, red, grey). -->
            <ImageView
                android:id="@+id/widget_glasses_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:tint="@color/widget_stale" />

            <!-- Ten-dot gauge, the Lens batteryDots: lit = round(% / 10), at least one. -->
            <LinearLayout
                android:id="@+id/widget_glasses_gauge"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_glasses_dot0"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot5"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot6"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot7"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot8"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_glasses_dot9"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_glasses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_dim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <!-- Number plus "%" or the charging bolt; tinted per state (white, red, grey). -->
            <ImageView
                android:id="@+id/widget_case_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:tint="@color/widget_stale" />

            <!-- Ten-dot gauge, the Lens batteryDots: lit = round(% / 10), at least one. -->
            <LinearLayout
                android:id="@+id/widget_case_gauge"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_case_dot0"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot5"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot6"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot7"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot8"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
                <ImageView
                    android:id="@+id/widget_case_dot9"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_case_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_dim" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
