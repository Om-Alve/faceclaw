<?xml version="1.0" encoding="utf-8"?>
<!--
  Home widget palette, light theme (values-night holds the dark one). The
  launcher resolves these when it inflates the tile, so the widget follows the
  system theme without the app repainting it. Mirrors the Lens tokens; red is
  only ever a low battery.
-->
<resources>
    <color name="widget_tile">#FFFFFF</color>
    <color name="widget_fg">#111111</color>
    <color name="widget_dim">#6B6B6B</color>
    <color name="widget_mute">#DCDCD8</color>
    <color name="widget_stale">#A3A3A0</color>
    <color name="widget_stale_dot">#C2C2BE</color>
    <color name="widget_red_text">#C4161D</color>
    <color name="widget_red_dot">#D71921</color>

    <!-- 24dp until Android 12, then the launcher's own radius (values-v31). -->
    <dimen name="widget_radius">24dp</dimen>
</resources>
